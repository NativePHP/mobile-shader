{
    "name": "nativephp/mobile-shader",
    "description": "GPU shader effects for NativePHP Mobile (Metal on iOS, AGSL on Android) as a native EDGE element",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "NativePHP",
            "email": "support@nativephp.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^2.7|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Native\\Mobile\\Shader\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Native\\Mobile\\Shader\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Native\\Mobile\\Shader\\ShaderServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
